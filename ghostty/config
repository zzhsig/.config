# =============================================================================
# Ghostty config — optimized for Neovim + tmux + Claude Code
# =============================================================================

# Font
font-family = SF Mono Terminal
font-size = 12

# Theme (Catppuccin Mocha — matches LazyVim default)
theme = GitHub Dark Dimmed

# Window
window-padding-x = 8
window-padding-y = 8
window-decoration = true

# Terminal behavior
mouse-hide-while-typing = true
copy-on-select = false

# Shell integration (enables better tmux detection)
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Scrollback (tmux handles this, keep it minimal)
scrollback-limit = 10000

# Cursor
cursor-style = block
cursor-style-blink = false

macos-icon = official
# Key bindings — leave Ctrl+a free for tmux prefix
# (Ghostty doesn't intercept Ctrl+a by default)

# Send clean <M-BS> (ESC+DEL) for Option+Delete so Neovim can map it reliably
keybind = opt+backspace=text:\x1b\x7f

# Cmd+number → tmux select-window (sends Ctrl+t prefix + number)
# Must unbind default goto_tab first (uses logical key names with higher priority)
keybind = cmd+digit_1=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+digit_9=unbind
keybind = cmd+digit_1=text:\x141
keybind = cmd+digit_2=text:\x142
keybind = cmd+digit_3=text:\x143
keybind = cmd+digit_4=text:\x144
keybind = cmd+digit_5=text:\x145
keybind = cmd+digit_6=text:\x146
keybind = cmd+digit_7=text:\x147
keybind = cmd+digit_8=text:\x148
keybind = cmd+digit_9=text:\x149
