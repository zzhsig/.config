% tapvid, s3

# Clone project(s) from test bucket (tapvid-agent) — spec: single id | id1,id2,id3 | 'prefix-*'
cd "$(~/.config/navi/scripts/s3-clone-project.sh tapvid-agent "<spec>")"

# Clone project(s) from prod bucket (tapvid-agent-prod) — spec: single id | id1,id2,id3 | 'prefix-*'
cd "$(~/.config/navi/scripts/s3-clone-project.sh tapvid-agent-prod "<spec>")"
