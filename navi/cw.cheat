% cloudwatch, cw, logs, lnav, tapvid

# All TapVid app logs now live in CloudWatch — EC2 test box logs ship to
# /ec2/tapvid-agent-service (one stream per process), ECS dev to /ecs/*-dev-us.
# Pick a <log> source and pipe through lnav for structured, navigable viewing
# (backend -> spring_boot_json_log, agent/workers -> tapvid_agent_log).

## Generic tail (any source)

# Tail live in lnav
cw tail -f <log> --region <region> | lnav

# Tail live with grep filter, in lnav
cw tail -f <log> --region <region> --grep "<pattern>" | lnav

# Recent history (time window) in lnav
cw tail <log> --region <region> -b <time> | lnav

# Errors only, in lnav
cw tail -f <log> --region <region> --grep "ERROR" | lnav

# Tail live to terminal (raw, for piping to jq/grep)
cw tail -f <log> --region <region>

# Tail a whole group's streams live, labelled by stream name
cw tail -f <group> --region <region> -s

# History to terminal (raw)
cw tail <log> --region <region> -b <time>

# List streams in a log group
cw ls streams <group> --region <region>

## Project lifecycle tracing (agent log)

# Track a project by ID (live, in lnav)
cw tail -f <log> --region <region> --grep "<project_id>" | lnav

# Track a project by ID (recent history, in lnav)
cw tail <log> --region <region> -b <time> --grep "<project_id>" | lnav

# Pipeline trace: full lifecycle for a project (history, in lnav)
cw tail <log> --region <region> -b <time> --grep "<project_id>" | grep -E "outline generation|Resolving scene plan|Prepared.*scene jobs|Running.*scenes|No checkpoint|starting fresh|Resuming interrupted|completed in|failed|raised unexpectedly|Recursion limit|Abandoned|E2E video generation|save_video_gen|Recovery|obfuscate|tts|TTS|blank screen|ERROR" | lnav

# Pipeline trace: failures only for a project (history)
cw tail <log> --region <region> -b <time> --grep "<project_id>" | grep -E "ERROR|failed|raised unexpectedly|Recursion limit|Abandoned|blank screen|Recovery failed"

## Agent error categories (live)

# Provider router issues (no slot / Redis failures)
cw tail -f <log> --region <region> | grep -E "no slot available|Redis unhealthy|Redis error"

# LLM pool fallback events
cw tail -f <log> --region <region> | grep -E "Falling back to OpenRouter|OpenRouter returned an error"

# Scene coding progress
cw tail -f <log> --region <region> | grep -E "\[coding\]|\[orchestrator\]|\[video_handler\]"

# Scene failures / recursion limits
cw tail -f <log> --region <region> | grep -E "failed|raised unexpectedly|Recursion limit"

# Abandoned / cancelled tasks
cw tail -f <log> --region <region> | grep -Ei "abandoned|cancelled"

# Worker health (heartbeat / retries / shutdown)
cw tail -f <log> --region <region> | grep -Ei "Worker|heartbeat|Max retries|graceful shutdown"

# TTS / audio errors
cw tail -f <log> --region <region> | grep -Ei "tts|elevenlabs|cosyvoice|audio"

# Blank screen detections
cw tail -f <log> --region <region> | grep -E "blank screen|BlankScreenValidator"

# S3 integrity / upload issues
cw tail -f <log> --region <region> | grep -E "S3 integrity|upload failed|obfuscate_and_upload"

# Auth rejections
cw tail -f <log> --region <region> | grep -E "Rejected request|invalid or missing X-Api-Key"

## Backend (Spring Boot) search

# Search backend logs by keyword (in lnav)
cw tail <log> --region <region> -b <time> -g '"<keyword>"' | lnav

# Search backend logs by two keywords (AND)
cw tail <log> --region <region> -b <time> -g '"<keyword1>" "<keyword2>"' | lnav

# Search backend errors by user UUID
cw tail <log> --region <region> -b <time> -g '"<user_uuid>" "ERROR"' | lnav

# Search backend logs by API endpoint
cw tail <log> --region <region> -b <time> -g '"<endpoint>"' | lnav

# Track user activity in backend
cw tail <log> --region <region> -b <time> -g '"<user_uuid>"' | lnav

$ log: printf '%s\n' "/ec2/tapvid-agent-service" "/ec2/tapvid-agent-service:agent" "/ec2/tapvid-agent-service:backend" "/ec2/tapvid-agent-service:project_worker" "/ec2/tapvid-agent-service:project_action_worker" "/ec2/tapvid-agent-service:document_worker" "/ec2/tapvid-agent-service:video_gen_worker" "/ec2/tapvid-agent-service:code_gen_worker" "/ecs/tapvid-ai-dev-us" "/ecs/tapvid-backend-dev-us"
$ group: printf '%s\n' "/ec2/tapvid-agent-service" "/ecs/tapvid-ai-dev-us" "/ecs/tapvid-backend-dev-us"
$ region: echo -e "us-east-1\nus-west-2"
$ pattern: echo -e "ERROR\nWARN\nTimeout\nException"
$ time: echo -e "5m\n15m\n30m\n1h\n6h\n24h"
$ endpoint: printf "/api/v1/project/create\n/api/v1/user/init\n/api/v1/user/profile\n"
